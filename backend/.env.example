# Required. Meta AI API key — server-side only, never bundle into the frontend.
META_API_KEY=

# Optional overrides (defaults shown).
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor

# Optional native Kokoro voice (python backend/scripts/setup_speech.py).
# SPEECH_MODEL_DIR=backend/data/speech

# Analysis tuning (verified defaults). Restore prior behavior with 1500 / null.
ANALYSIS_DETAIL_MAX_CHARS=6000
ANALYSIS_REASONING_EFFORT=low
