# Required. Meta AI API key — server-side only, never bundle into the frontend.
META_API_KEY=

# Optional overrides (defaults shown).
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor

# Analysis tuning controls. Conservative defaults until the live comparison passes.
# Candidate settings: ANALYSIS_DETAIL_MAX_CHARS=6000, ANALYSIS_REASONING_EFFORT=low
ANALYSIS_DETAIL_MAX_CHARS=1500
ANALYSIS_REASONING_EFFORT=null
