# Copy this file to .env at the repository root.
# Required. Meta AI API key: server-side only, never prefix with VITE_.
META_API_KEY=

# Optional overrides (defaults shown).
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3-contributor

# Analysis tuning (verified defaults). Restore prior behavior with 1500 / null.
ANALYSIS_DETAIL_MAX_CHARS=6000
ANALYSIS_REASONING_EFFORT=low

# Optional public frontend values (read at build time). Never put secrets here.
# VITE_MASCOT_MODEL=meta_chan
# VITE_MASCOT_VRM_URL=
# VITE_MASCOT_IDLE_URL=
